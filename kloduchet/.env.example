# Скопируйте этот файл в .env и заполните перед `docker compose up --build`.
# Реальный .env не должен попадать в git (см. tech_spec.md, раздел 8).

DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_DB=kloduchet
POSTGRES_USER=kloduchet
POSTGRES_PASSWORD=change-me
